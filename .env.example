# ── Application ──────────────────────────────────────────────────────────────
APP_ENV=dev                          # dev | prod
API_HOST=0.0.0.0
API_PORT=8000
API_KEY=change-me-in-prod            # Legacy key (kept for backward compat)
REQUIRE_AUTH_FOR_READS=false

# ── JWT auth (P1 RBAC) ────────────────────────────────────────────────────────
JWT_SECRET_KEY=CHANGE-ME-use-32-plus-random-bytes  # openssl rand -hex 32
JWT_EXPIRE_HOURS=8                   # Token lifetime (one full demo session)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
LOG_LEVEL=INFO
LOG_FORMAT=text                      # text | json

# ── Database ──────────────────────────────────────────────────────────────────
PLATFORM_DB_PATH=data/cache/platform.db
PIPELINE_OUTPUT_DIR=data/output
RESEED_ON_PIPELINE_CHANGE=false
SLA_DUE_SOON_DAYS=7

# ── Upload settings ──────────────────────────────────────────────────────────
UPLOAD_DIR=data/uploads
MAX_UPLOAD_SIZE_MB=50

# ── Scanner credentials (optional — for direct API pull) ─────────────────────
NESSUS_URL=https://nessus.example.com:8834
NESSUS_ACCESS_KEY=
NESSUS_SECRET_KEY=
OPENVAS_HOST=greenbone.example.com
OPENVAS_USERNAME=admin
OPENVAS_PASSWORD=

# ── Ticketing ─────────────────────────────────────────────────────────────────
TICKETING_PROVIDER=console           # console | jira
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=SEC
JIRA_ISSUE_TYPE=Task
JIRA_CLOSE_TRANSITION_NAME=Done
JIRA_VERIFY_TLS=true
JIRA_TIMEOUT_SECONDS=15

# ── RAG / Ollama ──────────────────────────────────────────────────────────────
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14b             # Recommended: qwen2.5:14b (~10 GB VRAM on RTX 4070 Ti Super)
OLLAMA_NUM_GPU=1                     # Set to 0 to force CPU (very slow)
OLLAMA_TIMEOUT_SECONDS=120
