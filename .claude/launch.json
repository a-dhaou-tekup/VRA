{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "python",
      "runtimeArgs": ["run_api.py"],
      "port": 8000
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev"],
      "port": 5173
    },
    {
      "name": "ollama",
      "runtimeExecutable": "ollama",
      "runtimeArgs": ["serve"],
      "port": 11434,
      "autoPort": false
    }
  ]
}
